PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/jobportal

# JWT Secrets
JWT_SECRET=super_secret_jwt_key_job_portal_2026_safe
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_job_portal_2026_safe
JWT_EXPIRE=30d
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=30d

# Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Cloudinary Cloud Storage Credentials
CLOUDINARY_CLOUD_NAME=your_dummy_cloud_name
CLOUDINARY_API_KEY=your_dummy_api_key
CLOUDINARY_API_SECRET=your_dummy_api_secret
