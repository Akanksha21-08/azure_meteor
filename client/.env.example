# ==========================================
# JobVerse Client Environment Configuration
# ==========================================

# In local development, leave this empty to use Vite's reverse proxy (/api -> http://localhost:5000)
# When deploying frontend to Vercel, set this to your deployed Render backend URL:
# Example: VITE_API_URL=https://jobverse-api.onrender.com
VITE_API_URL=
